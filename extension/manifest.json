{
  "manifest_version": 3,
  "name": "Purrsona",
  "version": "0.2.0",
  "description": "Your writing voice on a key you own. Option+M drafts replies to public posts (LinkedIn, X, Reddit) and rewrites your own words in private apps (Slack, Teams, Gmail), where it never reads the conversation.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8765/*",
    "http://localhost:8765/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/*",
        "https://x.com/*",
        "https://twitter.com/*",
        "https://www.reddit.com/*",
        "https://old.reddit.com/*",
        "https://app.slack.com/*",
        "https://teams.microsoft.com/*",
        "https://teams.live.com/*",
        "https://mail.google.com/*",
        "http://localhost:8765/practice/*",
        "http://127.0.0.1:8765/practice/*"
      ],
      "js": [
        "cat.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "draft-reply": {
      "description": "Draft in your voice (optional: the pages already listen for Option+M)"
    }
  },
  "action": {
    "default_title": "Purrsona"
  }
}
