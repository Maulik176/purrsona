{
  "manifest_version": 3,
  "name": "Purrsona",
  "version": "1.0.2",
  "description": "Your writing voice on a key you own. Option+M drafts replies to public posts (LinkedIn, X, Reddit) and rewrites your own words in private apps (Slack, Teams, Gmail), where it never reads the conversation.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1:8765/*",
    "http://localhost:8765/*",
    "https://purrsona-production.up.railway.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/*",
        "https://x.com/*",
        "https://twitter.com/*",
        "https://www.reddit.com/*",
        "https://old.reddit.com/*",
        "https://app.slack.com/*",
        "https://teams.microsoft.com/*",
        "https://teams.live.com/*",
        "https://mail.google.com/*",
        "http://localhost:8765/practice/*",
        "http://127.0.0.1:8765/practice/*"
      ],
      "js": [
        "cat.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://localhost:8765/",
        "http://127.0.0.1:8765/",
        "http://localhost:8765/console/*",
        "http://127.0.0.1:8765/console/*"
      ],
      "js": [
        "console-trigger.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "draft-reply": {
      "suggested_key": {
        "default": "Alt+M",
        "mac": "Alt+M"
      },
      "description": "Draft in your voice"
    }
  },
  "action": {
    "default_title": "Purrsona: open your dashboard",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "sounds/meow.mp3"
      ],
      "matches": [
        "https://www.linkedin.com/*",
        "https://x.com/*",
        "https://twitter.com/*",
        "https://www.reddit.com/*",
        "https://old.reddit.com/*",
        "https://app.slack.com/*",
        "https://teams.microsoft.com/*",
        "https://teams.live.com/*",
        "https://mail.google.com/*",
        "http://localhost:8765/*",
        "http://127.0.0.1:8765/*"
      ]
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
